async function handleGameButton(interaction, client) {
  const customId = interaction.customId;
  
  if (customId === "back_to_main_menu") {
    return showMainMenu(interaction);
  }
  if (customId === "menu_fishing") {
    const fishingModule = gameModules.fishing;
    if (fishingModule && fishingModule.showFishingMenu) {
      return fishingModule.showFishingMenu(interaction);
    }
    return interaction.reply({ content: "❌ Modul fishing tidak tersedia!", flags: 64 });
  }
  if (customId === "menu_hunt") {
    return showHuntMenu(interaction);
  }
  if (customId === "menu_casino") {
    return showCasinoMenu(interaction);
  }
  if (customId === "menu_profile") {
    return showProfile(interaction, client);
  }
  if (customId === "menu_reward") {
    return showRewardMenu(interaction);
  }
  if (customId === "menu_activity") {
    return showActivityInfo(interaction, client);
  }
  if (customId === "menu_activity_lb") {
    return showActivityLeaderboard(interaction, client);
  }
  if (customId === "menu_transfer") {
    return showTransferInfo(interaction);
  }
  
  if (customId.startsWith("reward_")) {
    if (customId === "reward_back") {
      return showRewardMenu(interaction);
    }
    return handleRewardButton(interaction, client);
  }
  if (customId === "back_to_reward_menu") {
    return showRewardMenu(interaction);
  }
  
  if (customId === "casino_cf" || customId === "casino_rps" || customId === "casino_slots" || 
      customId === "casino_roulette" || customId === "casino_dice") {
    const gameName = customId.replace("casino_", "");
    const gameModule = gameModules[gameName];
    if (gameModule && gameModule.showGameMenu) {
      return gameModule.showGameMenu(interaction);
    }
    return interaction.reply({ content: `❌ Game ${gameName} tidak tersedia!`, flags: 64 });
  }
  
  if (customId === "back_to_casino") {
    return showCasinoMenu(interaction);
  }
  
  if (customId === "game_hunt") {
    const huntModule = gameModules.hunt;
    if (huntModule && huntModule.showGameMenu) {
      return huntModule.showGameMenu(interaction);
    }
    return interaction.reply({ content: "❌ Game hunt tidak tersedia!", flags: 64 });
  }
  if (customId === "game_dungeon") {
    const dungeonModule = gameModules.dungeon;
    if (dungeonModule && dungeonModule.showGameMenu) {
      return dungeonModule.showGameMenu(interaction);
    }
    return interaction.reply({ content: "❌ Game dungeon tidak tersedia!", flags: 64 });
  }
  
  return false;
}

module.exports = {
  handleGameButton,
  showMainMenu,
  showCasinoMenu,
  showHuntMenu,
  showProfile,
  showRewardMenu,
  showActivityInfo,
  showActivityLeaderboard,
  showTransferInfo,
  setGameModules
};